# Скопируй нужные значения в .env. Существующие ключи не заменяй.
# Фото и видео
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Только фото
UNSPLASH_ACCESS_KEY=
RESERP_API_KEY=
BRIGHTDATA_API_KEY=
# Создай зону SERP API с этим именем или укажи имя своей зоны.
BRIGHTDATA_SERP_ZONE=serp_api1

# Основной Vision: TOP 2–4 после фильтра метаданных; второй проход только при сомнениях.
VISION_PROVIDER=apple
OPENROUTER_API_KEY=
VISION_PRIMARY_MODEL=qwen/qwen3.7-flash
VISION_FALLBACK_MODEL=qwen/qwen3.8-flash
VISION_CONFIDENCE_THRESHOLD=0.70
VISION_CLOSE_SCORE_MARGIN=0.08
VISION_MIN_SCORE=0.6
# Необязательный прежний провайдер; включается явно через VISION_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash

# YouTube через yt-dlp: API-ключ не требуется.
YOUTUBE_PUBLIC_SEARCH=1
YOUTUBE_ALLOW_CREATIVE_COMMONS=1
# Необязательный Netscape cookies.txt, если YouTube требует вход.
YOUTUBE_COOKIE_FILE=
# Необязательный список официальных каналов для source_policy=official; all не считается официальным каналом.
YOUTUBE_TRUSTED_CHANNELS=

# WhisperX large-v2: existing separate environment; leave empty for autodetection.
WHISPERX_PYTHON=
